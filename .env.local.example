# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key used by browser auth/session refresh
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only. Required for admin flows and future cron cleanup jobs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MiniMax API key used by /api/voices and /api/generate
MINIMAX_API_KEY=your-minimax-api-key

# Overseas MiniMax base URL. Current code defaults to this value.
MINIMAX_API_BASE=https://api.minimax.io/v1

# Optional network tuning for overseas API calls
MINIMAX_TIMEOUT_MS=120000
MINIMAX_MAX_RETRIES=2

# Optional for future API routing / logging; current code does not require it yet.
MINIMAX_GROUP_ID=your-minimax-group-id
